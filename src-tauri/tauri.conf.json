{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "12 недель",
  "version": "0.1.0",
  "identifier": "com.peretc.twelveweek",
  "build": {
    "beforeDevCommand": "npm run desktop:vite",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run desktop:vite:build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "12 недель",
        "width": 1280,
        "height": 840,
        "minWidth": 1180,
        "minHeight": 720,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app"],
    "category": "Productivity",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
